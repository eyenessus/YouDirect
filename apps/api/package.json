{
  "name": "@yudirect/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/database/seed.ts",
    "openapi": "tsx src/scripts/export-openapi.ts",
    "report:verify": "tsx src/scripts/verify-report.ts",
    "dev:demo": "npm run build && node dist/scripts/dev-demo.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "10.0.2",
    "@fastify/helmet": "13.0.1",
    "@fastify/multipart": "9.0.3",
    "@fastify/rate-limit": "10.2.2",
    "@fastify/static": "8.0.4",
    "@yudirect/contracts": "*",
    "csv-parse": "5.6.0",
    "exceljs": "4.4.0",
    "fastify": "5.2.1",
    "fastify-plugin": "5.0.1",
    "mongodb": "6.12.0",
    "pdfmake": "0.2.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/pdfmake": "0.2.10",
    "mongodb-memory-server": "10.1.2",
    "pino-pretty": "13.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
