# ------------------------------------------------------------------
# YuDirect — variáveis de ambiente
# Copie para .env e ajuste. NENHUM segredo real deve ser commitado.
# ------------------------------------------------------------------

# --------------------------------- API ----------------------------
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info

# MongoDB. Em desenvolvimento/teste, deixe VAZIO para subir um MongoDB
# em memória com replica set (necessário para transações).
# Em produção é OBRIGATÓRIO e deve apontar para um replica set.
MONGODB_URI=mongodb://yudirect:yudirect@localhost:27017/yudirect?replicaSet=rs0&authSource=admin
MONGODB_DB=yudirect
# Onde o MongoDB em memória guarda os dados (dev/test).
MONGO_MEMORY_DB_PATH=./.cache/mongo-data

APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3333
CORS_ORIGINS=http://localhost:5173

# Sessão: em produção o servidor RECUSA subir com o segredo padrão,
# com menos de 32 caracteres, COOKIE_SECURE=false ou URLs em localhost.
SESSION_COOKIE_NAME=yudirect_session
SESSION_TTL_HOURS=12
SESSION_SECRET=troque-este-segredo-em-producao
COOKIE_SECURE=false

# Criptografia de CPF/RG — independente do SESSION_SECRET. Sem PII_KEY o
# formato legado (derivado do SESSION_SECRET) continua valendo. Para migrar:
# defina PII_KEY e rode `node apps/api/dist/scripts/rotate-pii.js --apply`.
# Gere com: openssl rand -hex 32
# PII_KEY=
# PII_KEY_ID=k1
# PII_KEY_PREVIOUS=
# PII_KEY_PREVIOUS_ID=
# Depois de trocar o SESSION_SECRET, informe o antigo aqui (dados v1):
# PII_LEGACY_SECRET=
# PII_PEPPER=

# ------------------------------ Arquivos --------------------------
# mongo = Base64 na coleção fileBlobs do MongoDB (padrão; sem disco persistente)
# local = disco; s3 = bucket compatível com S3 (MinIO, AWS…)
STORAGE_DRIVER=mongo
STORAGE_LOCAL_DIR=./.storage
STORAGE_SIGNED_URL_TTL_SECONDS=900
# S3_BUCKET=yudirect
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --------------------------- Integrações --------------------------
# Enquanto estiverem vazias, a aplicação declara a indisponibilidade de
# forma explícita na interface — NUNCA simula envio, pagamento ou
# consulta bem-sucedida.

# Whaply — canal oficial de WhatsApp da FF Veículos para a coleta de
# vistoria (docs/architecture/yudirect-whaply-vistoria-plan.md §5.1).
# A conta e o número são fixados NO WHAPLY; aqui só ficam as chaves HMAC
# (uma por direção, 32+ caracteres). Gere com: openssl rand -hex 32
WHAPLY_INTEGRATION_ENABLED=false
# WHAPLY_API_URL=https://api.whaply.com
# WHAPLY_OUTBOUND_KEY_ID=yudirect-1
# WHAPLY_OUTBOUND_SECRET=
# WHAPLY_INBOUND_KEY_ID=whaply-1
# WHAPLY_INBOUND_SECRET=
# WHAPLY_INBOUND_KEY_ID_NEXT=
# WHAPLY_INBOUND_SECRET_NEXT=
# WHAPLY_TEMPLATE_REQUEST=yudirect_vistoria_solicitacao
# WHAPLY_TEMPLATE_REMINDER=yudirect_vistoria_lembrete
# WHAPLY_TEMPLATE_CORRECTION=yudirect_vistoria_correcao
# WHAPLY_JOBS_INTERVAL_SECONDS=60

# WhatsApp (disparo de mensagens e link de vistoria)
# WHATSAPP_PROVIDER=
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
# WHATSAPP_SENDER_ID=

# E-mail (convites, "esqueci a senha" e fallback da vistoria)
# Mailgun (recomendado):
# EMAIL_PROVIDER=mailgun
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.seudominio.com.br
# MAILGUN_REGION=us        # ou eu
# EMAIL_FROM=YuDirect <nao-responda@mg.seudominio.com.br>
# Genérico (POST JSON com Bearer):
# EMAIL_PROVIDER=
# EMAIL_API_URL=
# EMAIL_API_TOKEN=
# EMAIL_FROM=

# CEP — use {cep} como placeholder, ex.: https://viacep.com.br/ws/{cep}/json/
# POSTAL_CODE_PROVIDER_URL=

# Consulta de multas (DETRAN via provedor contratado)
# TRAFFIC_FINES_PROVIDER=
# TRAFFIC_FINES_API_URL=
# TRAFFIC_FINES_API_TOKEN=

# Cobrança da assinatura (ex.: Asaas)
# BILLING_PROVIDER=
# BILLING_API_URL=
# BILLING_API_TOKEN=

# Cobrança Pix dos motoristas (Mercado Pago, API de pagamentos).
# Sem o token, o Pix fica indisponível (a Área do Motorista oferece o WhatsApp).
# O webhook é /api/v1/webhooks/mercadopago (configure a URL e copie a "assinatura secreta").
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# PIX_PAYER_FALLBACK_EMAIL=cobranca@sua-locadora.com.br
# PIX_EXPIRATION_MINUTES=1440

# Assinatura digital do contrato com selfie + CNH (ZapSign).
# Sandbox: ZAPSIGN_API_URL=https://sandbox.api.zapsign.com.br
# Webhook: /api/v1/webhooks/zapsign com o cabeçalho "Authorization: Bearer <ZAPSIGN_WEBHOOK_SECRET>".
# ZAPSIGN_API_TOKEN=
# ZAPSIGN_WEBHOOK_SECRET=
# ZAPSIGN_SELFIE_VALIDATION=face-match-and-datavalid

# Análise de crédito do motorista — Serasa Experian, Relatório Básico PF.
# Detalhes: docs/integrations/serasa/README.md. Sem client id/secret a consulta
# fica indisponível. Credencial de PRODUÇÃO só roda com NODE_ENV=production.
# SERASA_ENVIRONMENT=homologacao
# SERASA_CLIENT_ID=
# SERASA_CLIENT_SECRET=
# SERASA_REPORT_NAME=RELATORIO_BASICO_PF_PME
# SERASA_OPTIONAL_FEATURES=
# SERASA_SCORE_MODEL=
# SERASA_RETAILER_DOCUMENT=   # só cliente distribuidor (CNPJ do consultante)
# SERASA_COST_CENTER=
# SERASA_TIMEOUT_MS=20000
# SERASA_RATE_LIMIT_PER_MINUTE=20

# ------------------------------- Jobs -----------------------------
JOBS_ENABLED=true
JOBS_INTERVAL_MINUTES=30

# --------------------------- Rate limiting ------------------------
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute
LOGIN_RATE_LIMIT_MAX=10

# ------------------------------- Seed -----------------------------
SEED_OWNER_EMAIL=erik@ffveiculos.example.com
# Senha do dono criado pelo seed de DEMONSTRAÇÃO. O seed recusa bancos
# reais (produção, Atlas ou com usuários); para um ambiente novo use
# apps/api/src/scripts/bootstrap.ts.
# SEED_OWNER_PASSWORD=

# -------------------------------- Web -----------------------------
# Em dev o Vite faz proxy de /api para a API; defina apenas se publicar
# a API em outro domínio.
# VITE_API_URL=https://api.seudominio.com.br/api/v1
