# ------------------------------------------------------------------
# YuDirect — variáveis de ambiente
# Copie para .env e ajuste. NENHUM segredo real deve ser commitado.
# ------------------------------------------------------------------

# --------------------------------- API ----------------------------
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info

# MongoDB. Em desenvolvimento/teste, deixe VAZIO para subir um MongoDB
# em memória com replica set (necessário para transações).
# Em produção é OBRIGATÓRIO e deve apontar para um replica set.
MONGODB_URI=mongodb://yudirect:yudirect@localhost:27017/yudirect?replicaSet=rs0&authSource=admin
MONGODB_DB=yudirect
# Onde o MongoDB em memória guarda os dados (dev/test).
MONGO_MEMORY_DB_PATH=./.cache/mongo-data

APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3333
CORS_ORIGINS=http://localhost:5173

# Sessão: troque SESSION_SECRET em produção (mín. 16 caracteres).
SESSION_COOKIE_NAME=yudirect_session
SESSION_TTL_HOURS=12
SESSION_SECRET=troque-este-segredo-em-producao
COOKIE_SECURE=false

# ------------------------------ Arquivos --------------------------
# mongo = Base64 na coleção fileBlobs do MongoDB (padrão; sem disco persistente)
# local = disco; s3 = bucket compatível com S3 (MinIO, AWS…)
STORAGE_DRIVER=mongo
STORAGE_LOCAL_DIR=./.storage
STORAGE_SIGNED_URL_TTL_SECONDS=900
# S3_BUCKET=yudirect
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --------------------------- Integrações --------------------------
# Enquanto estiverem vazias, a aplicação declara a indisponibilidade de
# forma explícita na interface — NUNCA simula envio, pagamento ou
# consulta bem-sucedida.

# WhatsApp (disparo de mensagens e link de vistoria)
# WHATSAPP_PROVIDER=
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
# WHATSAPP_SENDER_ID=

# E-mail (convites e fallback da vistoria)
# EMAIL_PROVIDER=
# EMAIL_API_URL=
# EMAIL_API_TOKEN=
# EMAIL_FROM=

# CEP — use {cep} como placeholder, ex.: https://viacep.com.br/ws/{cep}/json/
# POSTAL_CODE_PROVIDER_URL=

# Consulta de multas (DETRAN via provedor contratado)
# TRAFFIC_FINES_PROVIDER=
# TRAFFIC_FINES_API_URL=
# TRAFFIC_FINES_API_TOKEN=

# Cobrança da assinatura (ex.: Asaas)
# BILLING_PROVIDER=
# BILLING_API_URL=
# BILLING_API_TOKEN=

# ------------------------------- Jobs -----------------------------
JOBS_ENABLED=true
JOBS_INTERVAL_MINUTES=30

# --------------------------- Rate limiting ------------------------
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute
LOGIN_RATE_LIMIT_MAX=10

# ------------------------------- Seed -----------------------------
SEED_OWNER_EMAIL=erik@ffveiculos.example.com
SEED_OWNER_PASSWORD=YuDirect@2026

# -------------------------------- Web -----------------------------
# Em dev o Vite faz proxy de /api para a API; defina apenas se publicar
# a API em outro domínio.
# VITE_API_URL=https://api.seudominio.com.br/api/v1
